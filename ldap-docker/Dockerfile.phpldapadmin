FROM alpine:3.13

# Actualizar repositorios e instalar Apache, PHP y dependencias necesarias
RUN apk update && apk add --no-cache \
    apache2 \
    php7 \
    php7-ldap \
    php7-xml \
    php7-common \
    php7-gd \
    php7-mbstring \
    php7-curl \
    php7-apache2 \
    php7-session \
    php7-gettext \
    wget \
    unzip \
    git
# Descargar e instalar phpLDAPadmin desde GitHub
RUN mkdir -p /usr/share/phpldapadmin \
    && mkdir -p /etc/phpldapadmin \
    && git clone https://github.com/leenooks/phpLDAPadmin.git /usr/share/phpldapadmin \
    && cd /usr/share/phpldapadmin \
    && git checkout 1.2.6.3 \
    && cp config/config.php.example /etc/phpldapadmin/config.php \
    && ln -s /etc/phpldapadmin/config.php /usr/share/phpldapadmin/config/config.php

# Configurar Apache para phpLDAPadmin
RUN echo "ServerName localhost" >> /etc/apache2/httpd.conf \
    && echo "Include /etc/apache2/conf.d/php7-module.conf" >> /etc/apache2/httpd.conf \
    && echo "AddType application/x-httpd-php .php" >> /etc/apache2/httpd.conf \
    && echo "DirectoryIndex index.php" >> /etc/apache2/httpd.conf \
    && rm -f /etc/apache2/conf.d/default.conf \
    && echo "DocumentRoot /usr/share/phpldapadmin/htdocs" > /etc/apache2/conf.d/phpldapadmin.conf \
    && echo "<Directory /usr/share/phpldapadmin/htdocs>" >> /etc/apache2/conf.d/phpldapadmin.conf \
    && echo "    Options FollowSymLinks" >> /etc/apache2/conf.d/phpldapadmin.conf \
    && echo "    DirectoryIndex index.php" >> /etc/apache2/conf.d/phpldapadmin.conf \
    && echo "    AllowOverride All" >> /etc/apache2/conf.d/phpldapadmin.conf \
    && echo "    Require all granted" >> /etc/apache2/conf.d/phpldapadmin.conf \
    && echo "</Directory>" >> /etc/apache2/conf.d/phpldapadmin.conf

# Configurar php.ini para habilitar sesiones
RUN mkdir -p /etc/php7 \
    && echo "session.auto_start = 0" >> /etc/php7/php.ini \
    && echo "session.save_path = /tmp" >> /etc/php7/php.ini

# Configuración de phpLDAPadmin
COPY config.php /etc/phpldapadmin/config.php

# Ajustar permisos
RUN chown -R apache:apache /etc/phpldapadmin /usr/share/phpldapadmin \
    && chmod -R 755 /usr/share/phpldapadmin

# Exponer el puerto para Apache
EXPOSE 80

# Iniciar Apache en primer plano
CMD ["httpd", "-D", "FOREGROUND"] 